# Скопируйте в .env и заполните GEMINI_API_KEY
GEMINI_API_KEY=your_api_key_here

# По умолчанию gemini-2.5-flash для router и response (можно задать разные):
# GEMINI_MODEL_ROUTER=gemini-2.5-flash
# GEMINI_MODEL_RESPONSE=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=1024
# GEMINI_TIMEOUT_SECS=30
# GEMINI_RETRY_COUNT=3
# GEMINI_RETRY_BASE_DELAY_MS=500
# GEMINI_RETRY_MAX_DELAY_MS=8000
# GEMINI_LOG_PROMPTS=false
